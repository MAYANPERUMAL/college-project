# Tech Mart - Django & MySQL Configuration
SECRET_KEY=techmart-django-secret-key-production-change-this-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# MySQL Database Settings (Installed on your PC)
# Ensure MySQL Server 8.0 is running and techmart_db database exists
DB_ENGINE=django.db.backends.mysql
DB_NAME=techmart_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306

# Set to True if you wish to run on SQLite temporarily without MySQL
USE_SQLITE=False
